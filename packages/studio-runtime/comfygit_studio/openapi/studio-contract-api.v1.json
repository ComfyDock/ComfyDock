            "const": "upload_slot",
            "type": "string"
          },
          "max_size": {
            "type": "integer"
          },
          "method": {
            "const": "PUT",
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "upload_id": {
            "type": "string"
          },
          "upload_url": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "upload_id",
          "ref",
          "upload_url",
          "method",
          "destination",
          "file_ref"
        ],
        "type": "object"
      },
      "UploadStatusResponse": {
        "properties": {
          "file_ref": {
            "$ref": "#/components/schemas/FileRef"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "file_ref"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Public contract-shaped API used by cg serve, Manager embedded Studio, and future hosted ComfyGit endpoints.",
    "title": "ComfyGit Studio Contract API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/contracts": {
      "get": {
        "operationId": "listContracts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractsResponse"
                }
              }
            },
            "description": "Contracts response"
          }
        },
        "summary": "List available workflow contracts"
      }
    },
    "/contracts/{workflow}/{contract}": {
      "get": {
        "operationId": "getContract",
        "parameters": [
          {
            "$ref": "#/components/parameters/workflow"
          },
          {
            "$ref": "#/components/parameters/contract"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractSummary"
                }
              }
            },
            "description": "Contract response"
          }
        },
        "summary": "Return one workflow contract"
      }
    },
    "/contracts/{workflow}/{contract}/run": {
      "post": {
        "operationId": "runContract",
        "parameters": [
          {
            "$ref": "#/components/parameters/workflow"
          },
          {
            "$ref": "#/components/parameters/contract"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Run response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request too large"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Executor unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Run timed out"
          }
        },
        "summary": "Start a workflow contract run"
      }
    },
    "/gallery": {
      "get": {
        "operationId": "listGallery",
        "parameters": [
          {
            "$ref": "#/components/parameters/galleryLimit"
          },
          {
            "$ref": "#/components/parameters/galleryCursor"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryResponse"
                }
              }
            },
            "description": "Gallery response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid pagination request"
          }
        },
        "summary": "List gallery items for the current Studio session"
      }
    },
    "/gallery/{item_id}": {
      "delete": {
        "operationId": "deleteGalleryItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/itemId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryDeleteResponse"
                }
              }
            },
            "description": "Delete response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryDeleteResponse"
                }
              }
            },
            "description": "Gallery item was not found"
          }
        },
        "summary": "Delete one gallery item from the current session"
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/checkProxy"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Health response"
          }
        },
        "summary": "Return Studio runtime and executor health"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OpenAPI document"
          }
        },
        "summary": "Return the Studio contract API OpenAPI document"
      }
    },
    "/outputs/view": {
      "get": {
        "operationId": "viewOutput",
        "parameters": [
          {
            "$ref": "#/components/parameters/serveArtifact"
          },
          {
            "$ref": "#/components/parameters/filename"
          },
          {
            "$ref": "#/components/parameters/subfolder"
          },
          {
            "$ref": "#/components/parameters/outputType"
          }
        ],
        "responses": {
          "200": {
            "description": "Output bytes"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Output not found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ComfyUI unavailable"
          }
        },
        "summary": "Fetch a generated output artifact"
      }
    },
    "/runs": {
      "get": {
        "operationId": "listRuns",
        "parameters": [
          {
            "$ref": "#/components/parameters/activeRuns"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
