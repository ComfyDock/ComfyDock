# E2E Test Configuration
# ======================
# Copy to .env and customize paths as needed.
# All paths support environment variable expansion.

# Shared UV cache (persists across test runs)
# Contains PyTorch and other heavy packages (~2GB)
# Default: tests/e2e/.cache/uv
E2E_UV_CACHE_DIR=${PWD}/.cache/uv

# Shared ComfyUI base clone (cloned once with --depth 1)
# Copied to fixtures to avoid repeated cloning
# Default: tests/e2e/.cache/comfyui-base
E2E_COMFYUI_BASE_DIR=${PWD}/.cache/comfyui-base

# Fixture workspace directory
# Contains pre-built workspaces for testing
# Default: tests/e2e/fixtures
E2E_FIXTURES_DIR=${PWD}/fixtures

# ComfyUI version for test fixtures
# Pinned for reproducibility
E2E_COMFYUI_VERSION=v0.4.0

# Python version for test environments
E2E_PYTHON_VERSION=3.12

# Optional: Override ComfyUI port for integration tests
# Default: 8188
# E2E_COMFYUI_PORT=8188
